{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shellhive",
  "version": "1.3.0",
  "identifier": "com.davidgoncalves.shellhive",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Shellhive",
        "width": 1280,
        "height": 800,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Terminal com abas agrupadas para o Claude Code",
    "longDescription": "Terminal com abas agrupadas por assunto, estado de cada sessao do Claude Code, fila de permissoes, busca nas sessoes antigas e editor em painel.",
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ],
        "conflicts": [
          "claude-terminal"
        ],
        "replaces": [
          "claude-terminal"
        ]
      }
    },
    "macOS": {
      "entitlements": "./Entitlements.plist"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "active": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIyNzVCRjAxQUUxRDI5RDkKUldUWktSMnVBYjkxSW51UXlsNHE2WFFWS2huV21aTFdlY3dNdlJ6U3BTWHpFZlVidVJrejQ4NDMK",
      "endpoints": [
        "https://github.com/davidsgoncalves/shellhive/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
